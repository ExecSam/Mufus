# Copy to .env and adjust. docker compose reads .env automatically.

# Host port the site is served on
PORT=8080

# Host address to bind to: 0.0.0.0 for all interfaces, or 127.0.0.1 when a reverse
# proxy or Cloudflare Tunnel on the same host sits in front of the site
BIND_ADDRESS=0.0.0.0

# Name of the container
CONTAINER_NAME=mufus-web
